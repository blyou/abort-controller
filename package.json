{
  "name": "@blyou/abort-controller",
  "version": "1.0.1",
  "description": "WHATWG DOM Standard compliant AbortController and AbortSignal with zero dependencies.",
  "keywords": [
    "abortcontroller",
    "abortsignal",
    "whatwg"
  ],
  "homepage": "https://github.com/blyou/abort-controller#readme",
  "bugs": {
    "url": "https://github.com/blyou/abort-controller/issues"
  },
  "license": "MIT",
  "author": "blyou <youbolincode@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blyou/abort-controller.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "git:hooks": "pnpm simple-git-hooks",
    "taze": "pnpx taze -I"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vue/eslint-config-typescript": "^14.9.0",
    "bumpp": "^11.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.73.0",
    "eslint-plugin-vue": "^10.9.2",
    "lint-staged": "^17.0.8",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}
